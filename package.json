    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "typescript": "^5",
    "fast-glob": "file:vendor/eslint-glob"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.23"
